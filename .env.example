# ============================================================================
# KI-Hub – Umgebungsvariablen (VORLAGE)
# ----------------------------------------------------------------------------
# 1. Kopieren:   cp .env.example .env
# 2. Werte eintragen (ECHTE Keys NUR in .env, NIEMALS committen – s. .gitignore)
# ============================================================================

# --- Docker-Netz des bestehenden n8n/Ollama-Setups (auf dem Server ermitteln) ---
#     docker network ls        -> Name hier eintragen (z. B. "n8n_default")
HUB_NETWORK=CHANGE_ME_docker_network_name

# --- Ollama (lokal, im selben Docker-Netz) ---
OLLAMA_API_BASE=http://ollama:11434

# --- LiteLLM Gateway ---
# Master-Key = Admin-Zugang zum Router. Starkes Zufallsgeheimnis erzeugen:
#   openssl rand -hex 32   (Ergebnis mit Präfix "sk-" versehen)
LITELLM_MASTER_KEY=sk-CHANGE_ME_langer_zufallswert

# --- Logging-Datenbank (Postgres) ---
#   openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_db_passwort

# --- Cloud-Anbieter-Keys ---
# Anthropic (bereits vorhanden – gleicher Key wie in n8n):
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
# OpenAI (neu anzulegen):
OPENAI_API_KEY=sk-CHANGE_ME
# Google Gemini (neu anzulegen):
GEMINI_API_KEY=CHANGE_ME
