# Live-Dashboard-Dienst — Umgebungsvariablen (keine echten Werte committen).

# Interner n8n-Webhook "dashboard-status" (Workflow "Dashboard API - Live
# Workflow Status"). Bei getrenntem Host: https://n8n.compliancemanufaktur.online/webhook/dashboard-status
DASHBOARD_URL=http://n8n:5678/webhook/dashboard-status

# Header-Key für den Webhook (Header-Name: X-Dashboard-Key). Identisch mit
# DASHBOARD_API_KEY aus Vercel. NUR serverseitig. KEIN n8n-REST-API-Key nötig.
DASHBOARD_API_KEY=

# Optional:
# PORT=8080
# POLL_MS=4000      # Poll-Intervall in ms (min. 2000)
