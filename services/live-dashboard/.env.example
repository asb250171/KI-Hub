# Live-Dashboard-Dienst — Umgebungsvariablen (keine echten Werte committen).

# Interne n8n-Adresse (Docker-Servicename). Bei getrenntem Host: https://n8n.compliancemanufaktur.online
N8N_API_URL=http://n8n:5678

# n8n API-Key: n8n → Einstellungen → n8n API → API Key erstellen. NUR serverseitig.
N8N_API_KEY=

# Optional:
# PORT=8080
# POLL_MS=4000      # Poll-Intervall in ms (min. 2000)
# MAX_EXEC=200      # Anzahl zuletzt berücksichtigter Executions
